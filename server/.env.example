# Railway injects DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random long secret used to sign login JWTs. Generate your own, don't reuse this.
JWT_SECRET=change_me_to_a_long_random_string

# BotFather token for the Telegram bot.
BOT_TOKEN=123456:ABC-your-bot-token

# Comma-separated Telegram numeric user IDs allowed to use admin commands.
ADMIN_TELEGRAM_IDS=123456789

# HTTP port the API listens on (Railway sets PORT automatically).
PORT=3000

# --- Paylov (WLCM / Octagram) — Click / Payme / Uzum / karta ---
# Prod: https://api.wlcm.uz   |   Sandbox: https://apidev.wlcm.uz
WLCM_BASE_URL=https://api.wlcm.uz
# Onboarding token'dan zarb qilinadi (POST /api/v1/partners/onboarding/?token=...)
# DIQQAT: POST faqat BIR MARTA ishlaydi va faqat whitelist qilingan IP'dan.
WLCM_API_KEY=
WLCM_API_SECRET=
# To'lovdan keyin foydalanuvchi qaytadigan manzil (bot havolasi)
PAYLOV_RETURN_URL=https://t.me/YourBotUsername

# Eski placeholder webhook (hozircha ishlatilmaydi)
PAYLOV_WEBHOOK_SECRET=
